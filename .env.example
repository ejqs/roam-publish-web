DATABASE_URL=postgres://postgres:postgres@localhost:5433/roam_publish
BETTER_AUTH_SECRET=change-me-to-32-plus-random-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional in dev: without it, emails are logged to the console
RESEND_API_KEY=
EMAIL_FROM="Roam Publish <noreply@example.com>"
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored Roam append-only tokens for the change log.
APPEND_TOKEN_KEY=
# Only while rotating the key: the old one, so tokens not yet re-encrypted still work (see README).
# APPEND_TOKEN_KEY_PREVIOUS=
# Optional, for local testing only: send Append API calls to a stand-in instead of Roam.
# ROAM_APPEND_API=http://localhost:4555
